# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────
# Local:  mongodb://localhost:27017/tictify
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/tictify
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ─── Google OAuth (optional for now) ────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Email (Nodemailer) ──────────────────────────────────
# For dev: use Mailtrap (https://mailtrap.io) — free fake inbox
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@tictify.pk
EMAIL_FROM_NAME=Tictify

# ─── Frontend URL (for CORS) ────────────────────────────
CLIENT_URL=http://localhost:5173
